generator client {
  provider = "prisma-client"
  output   = "../.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                @id @default(cuid())
  email               String                @unique
  password            String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  profile             AthleteProfile?
  trainingPlans       TrainingPlan[]
  garminToken         GarminToken?
  googleCalendarToken GoogleCalendarToken?
  stravaToken         StravaToken?
  stravaActivities    StravaActivity[]
  documents           AthleteDocument[]
  raceProfile         RaceProfile?
  suggestions         ProfileSuggestion[]
  adaptations         Adaptation[]
  reports             AthleteReport[]
  decisions           PlanDecision[]
  availability        TrainingAvailability?
}

/// Files the athlete uploads (spreadsheets, notes, past plans) that give the
/// AI coach extra context it cannot get from Strava.
model AthleteDocument {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename    String
  fileType    String // csv | xlsx | txt
  content     String // Extracted plain-text content
  rowCount    Int?
  includeInAi Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model AthleteProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Basics ---
  age             Int?
  gender          String?
  raceDate        DateTime?
  raceType        String?
  pastPerformance String?
  timezone        String?   @default("UTC")

  // --- Physical ---
  heightCm   Float?
  weightKg   Float?
  bodyFatPct Float?

  // --- Baseline physiology ---
  restingHeartRate   Int?
  hrv                Int? // ms (rMSSD)
  maxHeartRate       Int?
  thresholdHeartRate Int?
  ftpWatts           Int?

  // --- Preferences ---
  favouriteSport       String? // Swim | Bike | Run
  leastFavouriteSport  String?
  swimDifficulty       Float?  @default(1.0)
  bikeDifficulty       Float?  @default(1.0)
  runDifficulty        Float?  @default(1.0)
  weeklyHoursAvailable Float?

  // --- Health / medical ---
  injuryHistory       String?
  ongoingIssues       String?
  chronicConditions   String?
  mobilityLimitations String?

  // --- Menstrual cycle (optional) ---
  tracksMenstrualCycle Boolean?  @default(false)
  cycleLengthDays      Int?
  lastPeriodStart      DateTime?

  // --- Swim specifics ---
  swimCssSecPer100     Int? // Critical Swim Speed, seconds per 100m
  swimStrokeCount      Int? // strokes per length
  swimStrokeRate       Int? // strokes per minute
  swimComfortOpenWater String? // e.g. "confident" | "nervous"

  // --- Bike specifics ---
  bikeLthr       Int? // Lactate threshold HR on the bike
  bikeMaxHr      Int?
  bikeAvgCadence Int?

  // --- Run specifics ---
  runThresholdPaceSec Int? // seconds per km at threshold
  runLthr             Int?
  runMaxHr            Int?
  runCadence          Int? // steps per minute
  runGroundContactMs  Int?
  runVerticalOscMm    Float?
  /// When each threshold was last actually established, and how.
  /// Shape: { "ftp": { "at": ISO, "source": "manual"|"test"|"derived" }, ... }
  /// Confidence decay (v3 §2.1) reads these dates. Without them the engine was
  /// falling back to `updatedAt`, which moves on any profile write and so
  /// credited thresholds nobody had re-established.
  thresholdsMeasuredAt Json?

  /// Tests the athlete has chosen to skip, so the engine stops offering them
  /// for a while. Shape: { "ftp": { "declinedAt": ISO } }.
  /// v3's North Star: never ask a question they have no new information to
  /// answer. Re-offering a declined test every day is exactly that.
  testPreferences Json?

  /// Choices the athlete has made about how their plan is built, e.g.
  /// { "rampRate": 0.08 } after electing to rebuild faster post-break.
  trainingPreferences Json?

  pb5kSec             Int?
  pb10kSec            Int?
  pbHalfSec           Int?
  pbMarathonSec       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// The athlete's TIME BUDGET — how many hours they can give to training on
/// each day of the week, plus practical constraints.
///
/// This is deliberately separate from physical capacity: how much time someone
/// HAS is a life constraint they must tell us, whereas how much load their body
/// can absorb is derived from their training history. The plan must respect
/// whichever of the two is the tighter limit.
model TrainingAvailability {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// When true, time is not a limiting factor. The plan is then bound purely
  /// by what the athlete's body can absorb, and the per-day hours are ignored.
  noTimeConstraints Boolean @default(false)

  // Hours available per day (0 = not available)
  monHours Float @default(0)
  tueHours Float @default(0)
  wedHours Float @default(0)
  thuHours Float @default(0)
  friHours Float @default(0)
  satHours Float @default(0)
  sunHours Float @default(0)

  /// Day the athlete prefers for their longest session.
  longSessionDay String?
  /// Days they cannot train at all, or facility limits, in their own words.
  constraints    String?
  /// Access to facilities, so sessions can be prescribed realistically.
  poolAccess     Boolean @default(true)
  gymAccess      Boolean @default(true)
  indoorTrainer  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A difference between what the athlete entered and what we found in their
/// data. The athlete decides whether to keep theirs or accept ours.
model ProfileSuggestion {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  field            String
  label            String
  valueType        String   @default("number") // number | string
  currentValue     String?
  currentDisplay   String?
  suggestedValue   String
  suggestedDisplay String
  origin           String
  status           String   @default("pending") // pending | accepted | dismissed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, field])
  @@index([userId, status])
}

/// Specific demands of the goal race — topography, water, climate.
/// Values may be suggested by the AI but must be confirmed by the athlete.
model RaceProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  raceName     String?
  location     String?
  raceDate     DateTime?
  distanceType String? // Sprint | Olympic | 70.3 | Full IM

  // Swim
  swimEnvironment String? // ocean | lake | river | pool
  waterTempC      Float?
  wetsuitLikely   Boolean?
  swimNotes       String?

  // Bike
  bikeElevationGainM Int?
  bikeCourseType     String? // flat | rolling | hilly | mountainous
  bikeTechnicality   String?
  bikeNotes          String?

  // Run
  runElevationGainM Int?
  runCourseType     String?
  runSurface        String? // road | trail | mixed
  runNotes          String?

  // Climate
  expectedTempC    Float?
  expectedHumidity Int?
  windNotes        String?

  /// Where the values came from and whether the athlete has confirmed them.
  source       String    @default("manual") // manual | ai_suggested | web_research
  confirmed    Boolean   @default(false)
  aiConfidence String? // high | medium | low
  sources      String? // URLs the facts came from
  researchedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

/// Something the athlete told the coach, in their own words, and what the
/// parser made of it. Kept event-sourced like Adaptation: the raw text is the
/// evidence, and any plan change must be traceable back to it.
/// A judgement call the engine must not make alone.
///
/// Some choices are genuinely the athlete's: how hard to come back after a
/// break, whether to rebuild a plan that no longer fits. The engine states the
/// evidence and the options, the athlete decides, and the answer is remembered
/// so the same question is never asked twice.
model PlanDecision {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Stable identifier, e.g. "ramp_after_break". One open decision per kind.
  kind     String
  question String
  /// Why this is being asked, in the athlete's terms.
  context  String
  /// [{ id, label, detail, recommended }]
  options  Json
  /// Numbers behind it, for the audit trail.
  facts    Json?

  /// "pending" | "answered" | "expired"
  status   String  @default("pending")
  answer   String?
  answeredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind])
  @@index([userId, status])
}

model AthleteReport {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Exactly what they typed. Never overwritten.
  rawText String
  /// The structured reading: niggles, fatigue, unavailable sports, horizon.
  parsed  Json
  /// Window the report applies to, so the engine knows how long to honour it.
  fromDate DateTime
  toDate   DateTime

  /// The engine's reply, so the conversation can be replayed.
  reply     String?
  /// Links to the adaptation this report caused, when it caused one.
  adaptationId String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model TrainingPlan {
  id             String            @id @default(cuid())
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRaceDate DateTime
  startDate      DateTime? // Monday of week 1 — anchors sessions to real calendar dates
  currentPhase   String? // e.g., "Base", "Build", "Taper"
  weekCount      Int               @default(12)
  detailedWeeks  Int               @default(0) // How many weeks have full session detail
  sessions       PlannedSession[]
  outline        PlanWeekOutline[]
  versions       PlanVersion[]
  adaptations    Adaptation[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([userId])
}

/// High-level view of EVERY week from now until race day, even weeks whose
/// individual sessions have not been generated in detail yet.
model PlanWeekOutline {
  id          String       @id @default(cuid())
  planId      String
  plan        TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  week        Int
  phase       String // Base / Build / Peak / Taper / Race
  focus       String? // What this week is for
  targetHours Float?
  targetTss   Int?
  isRaceWeek  Boolean      @default(false)
  createdAt   DateTime     @default(now())

  @@unique([planId, week])
  @@index([planId])
}

model PlannedSession {
  id            String       @id @default(cuid())
  planId        String
  plan          TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  week          Int
  phase         String? // e.g., "Base Building" (week-level metadata)
  summary       String? // Week overview text (week-level metadata)
  day           String // e.g., "Monday"
  // The real calendar day this session sits on. Derived from the plan's
  // startDate at creation, but authoritative afterwards: the adaptation engine
  // moves sessions by changing this, which "Week 2, Wednesday" cannot express.
  scheduledDate DateTime?
  discipline    String // e.g., "Swim", "Bike", "Run", "Brick"
  type          String // e.g., "Endurance", "Tempo", "Recovery"
  duration      String // e.g., "45 min"
  tss           Int // Training Stress Score
  instructions  String? // Detailed workout instructions
  pace          String? // Pace/effort guidance
  status        String       @default("planned") // e.g., "planned", "completed", "skipped", "adapted"
  actualTss     Int? // Actual TSS from a completed activity
  completedAt   DateTime?

  /// The athlete's own correction to what a completed session actually was —
  /// e.g. "did 3x3 instead of 6x3, calf felt tight". Strava can only see
  /// duration and effort; it cannot know the prescribed set/rep structure was
  /// cut short, so the athlete is the only source for this. Free text, never
  /// inferred (project rule 2).
  athleteNote   String?

  /// The athlete's own read of how hard the session felt vs what was planned
  /// (e.g. "very hard", "easy"). Free text, athlete-sourced only — the coach
  /// never infers this from Strava (project rule 2). Qualitative: unlike
  /// `actualTss` it never moves the load; it informs the coach's read.
  difficulty    String?

  /// What the athlete noticed in the body during/after — e.g. "left calf tight,
  /// quads sore". Free text, athlete-sourced only. Informs adaptation as a soft
  /// qualitative signal; the load numbers still come from `actualTss`/Strava.
  bodyNote      String?

  // --- Adaptation engine fields ---------------------------------------
  // Anchor sessions survive every daily adaptation (spec Part 3.2).
  isAnchor     Boolean   @default(false)
  // What the session is *for*. The solver preserves purpose, not shape.
  purpose      String?
  // Where this session started, so we can always show what changed.
  originalDate DateTime?
  originalTss  Int?
  // Set when the engine has moved or reshaped this session.
  adaptedAt    DateTime?

  /// Links a row created from an unplanned activity back to its Strava
  /// activity, so reconciliation stays idempotent.
  sourceActivityId String?

  /// A fitness test injected by the engine (v3 §3.4), and which threshold it
  /// is meant to re-establish.
  isTest   Boolean @default(false)
  testKind String?
  /// "device"  the athlete's kit records it, so we read the result from Strava
  /// "manual"  they have no such device: we explain how to capture it by hand
  ///           and they type the result in
  testMode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, week])
  @@index([planId, scheduledDate])
  @@unique([planId, sourceActivityId])
}

/// An immutable snapshot of a plan at a point in time (spec Part 2.4).
/// Plans are event-sourced: we never silently overwrite, we version.
model PlanVersion {
  id        String       @id @default(cuid())
  planId    String
  plan      TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  version   Int
  /// Full session list as it stood, so any version can be reconstructed.
  snapshot  Json
  createdAt DateTime     @default(now())

  adaptations Adaptation[]

  @@unique([planId, version])
  @@index([planId, createdAt])
}

/// A single, signed adaptation event: why the plan changed and exactly what
/// changed. Append-only — this is the audit trail the athlete can read.
model Adaptation {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId    String
  plan      TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  versionId String?
  version   PlanVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  /// Which signal engine caused this, e.g. "execution_drift", "guardrail".
  trigger        String
  /// Machine-readable cause: the constraints that were emitted.
  cause          Json
  /// The concrete before/after per session.
  diff           Json
  /// Plan scores either side of the change, for the hysteresis audit.
  scoreBefore    Float?
  scoreAfter     Float?
  /// Hash of the inputs, so an identical situation is detectable.
  inputHash      String?
  /// Natural-language rationale: cause -> action -> what it protects.
  explanation    String?
  /// "applied" | "rejected_hysteresis" | "blocked_frozen" | "no_change"
  outcome        String  @default("applied")
  /// Athlete feedback, for the learning layer later.
  athleteVerdict String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([planId, createdAt])
}

model GarminToken {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model GoogleCalendarToken {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model StravaToken {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken   String
  refreshToken  String
  expiresAt     DateTime // Strava access tokens are short-lived (~6h)
  athleteId     String? // Strava athlete id
  athleteName   String?
  scope         String?
  lastSyncedAt  DateTime? // When the background job last pulled activities
  lastSyncError String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model StravaActivity {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  stravaId       String // Strava's own activity id (used to avoid duplicates)
  name           String
  sportType      String // Raw Strava type, e.g. "Run", "Ride", "Swim"
  discipline     String // Normalised: Swim | Bike | Run | Strength | Other
  startDate      DateTime
  movingTime     Int // seconds
  elapsedTime    Int? // seconds
  distance       Float // meters
  elevationGain  Float? // meters
  avgHeartRate   Float?
  maxHeartRate   Float?
  avgSpeed       Float? // m/s
  avgWatts       Float?
  sufferScore    Float? // Strava "relative effort" when available
  estimatedTss   Int // Our own training-load estimate
  isTrainer      Boolean            @default(false)
  /// Whether we have pulled the detailed activity (for official best efforts).
  detailsFetched Boolean            @default(false)
  bestEfforts    StravaBestEffort[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([userId, stravaId])
  @@index([userId, startDate])
}

/// Official "best effort" splits Strava calculates inside a run
/// (e.g. the fastest 5 km contained within a 10 km run).
model StravaBestEffort {
  id          String         @id @default(cuid())
  activityId  String
  activity    StravaActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId      String
  name        String // "5k", "10k", "Half-Marathon", "Marathon", ...
  distance    Float // metres
  elapsedTime Int // seconds
  movingTime  Int?
  startDate   DateTime
  createdAt   DateTime       @default(now())

  @@unique([activityId, name])
  @@index([userId, name])
}
