generator client {
  provider = "prisma-client"
  output   = "../.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  profile   AthleteProfile?
  trainingPlans TrainingPlan[]
  garminToken GarminToken?
  googleCalendarToken GoogleCalendarToken?
  stravaToken StravaToken?
  stravaActivities StravaActivity[]
  documents AthleteDocument[]
  raceProfile RaceProfile?
  suggestions ProfileSuggestion[]
}

/// Files the athlete uploads (spreadsheets, notes, past plans) that give the
/// AI coach extra context it cannot get from Strava.
model AthleteDocument {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename    String
  fileType    String   // csv | xlsx | txt
  content     String   // Extracted plain-text content
  rowCount    Int?
  includeInAi Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId])
}

model AthleteProfile {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // --- Basics ---
  age             Int?
  gender          String?
  raceDate        DateTime?
  raceType        String?
  pastPerformance String?
  timezone        String?   @default("UTC")

  // --- Physical ---
  heightCm        Float?
  weightKg        Float?
  bodyFatPct      Float?

  // --- Baseline physiology ---
  restingHeartRate    Int?
  hrv                 Int?     // ms (rMSSD)
  maxHeartRate        Int?
  thresholdHeartRate  Int?
  ftpWatts            Int?

  // --- Preferences ---
  favouriteSport      String?  // Swim | Bike | Run
  leastFavouriteSport String?
  swimDifficulty  Float?  @default(1.0)
  bikeDifficulty  Float?  @default(1.0)
  runDifficulty   Float?  @default(1.0)
  weeklyHoursAvailable Float?

  // --- Health / medical ---
  injuryHistory        String?
  ongoingIssues        String?
  chronicConditions    String?
  mobilityLimitations  String?

  // --- Menstrual cycle (optional) ---
  tracksMenstrualCycle Boolean? @default(false)
  cycleLengthDays      Int?
  lastPeriodStart      DateTime?

  // --- Swim specifics ---
  swimCssSecPer100     Int?   // Critical Swim Speed, seconds per 100m
  swimStrokeCount      Int?   // strokes per length
  swimStrokeRate       Int?   // strokes per minute
  swimComfortOpenWater String? // e.g. "confident" | "nervous"

  // --- Bike specifics ---
  bikeLthr             Int?   // Lactate threshold HR on the bike
  bikeMaxHr            Int?
  bikeAvgCadence       Int?

  // --- Run specifics ---
  runThresholdPaceSec  Int?   // seconds per km at threshold
  runLthr              Int?
  runMaxHr             Int?
  runCadence           Int?   // steps per minute
  runGroundContactMs   Int?
  runVerticalOscMm     Float?
  pb5kSec              Int?
  pb10kSec             Int?
  pbHalfSec            Int?
  pbMarathonSec        Int?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// A difference between what the athlete entered and what we found in their
/// data. The athlete decides whether to keep theirs or accept ours.
model ProfileSuggestion {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  field            String
  label            String
  valueType        String   @default("number") // number | string
  currentValue     String?
  currentDisplay   String?
  suggestedValue   String
  suggestedDisplay String
  origin           String
  status           String   @default("pending") // pending | accepted | dismissed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, field])
  @@index([userId, status])
}

/// Specific demands of the goal race — topography, water, climate.
/// Values may be suggested by the AI but must be confirmed by the athlete.
model RaceProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  raceName      String?
  location      String?
  raceDate      DateTime?
  distanceType  String?  // Sprint | Olympic | 70.3 | Full IM

  // Swim
  swimEnvironment String?  // ocean | lake | river | pool
  waterTempC      Float?
  wetsuitLikely   Boolean?
  swimNotes       String?

  // Bike
  bikeElevationGainM Int?
  bikeCourseType     String? // flat | rolling | hilly | mountainous
  bikeTechnicality   String?
  bikeNotes          String?

  // Run
  runElevationGainM Int?
  runCourseType     String?
  runSurface        String? // road | trail | mixed
  runNotes          String?

  // Climate
  expectedTempC     Float?
  expectedHumidity  Int?
  windNotes         String?

  /// Where the values came from and whether the athlete has confirmed them.
  source        String   @default("manual") // manual | ai_suggested | web_research
  confirmed     Boolean  @default(false)
  aiConfidence  String?  // high | medium | low
  sources       String?  // URLs the facts came from
  researchedAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TrainingPlan {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRaceDate DateTime
  startDate     DateTime? // Monday of week 1 — anchors sessions to real calendar dates
  currentPhase  String?   // e.g., "Base", "Build", "Taper"
  weekCount     Int       @default(12)
  detailedWeeks Int       @default(0) // How many weeks have full session detail
  sessions      PlannedSession[]
  outline       PlanWeekOutline[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}

/// High-level view of EVERY week from now until race day, even weeks whose
/// individual sessions have not been generated in detail yet.
model PlanWeekOutline {
  id           String   @id @default(cuid())
  planId       String
  plan         TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  week         Int
  phase        String   // Base / Build / Peak / Taper / Race
  focus        String?  // What this week is for
  targetHours  Float?
  targetTss    Int?
  isRaceWeek   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([planId, week])
  @@index([planId])
}

model PlannedSession {
  id            String    @id @default(cuid())
  planId        String
  plan          TrainingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  week          Int
  phase         String?   // e.g., "Base Building" (week-level metadata)
  summary       String?   // Week overview text (week-level metadata)
  day           String    // e.g., "Monday"
  discipline    String    // e.g., "Swim", "Bike", "Run", "Brick"
  type          String    // e.g., "Endurance", "Tempo", "Recovery"
  duration      String    // e.g., "45 min"
  tss           Int       // Training Stress Score
  instructions  String?   // Detailed workout instructions
  pace          String?   // Pace/effort guidance
  status        String    @default("planned") // e.g., "planned", "completed", "skipped", "adapted"
  actualTss     Int?      // Actual TSS from Garmin
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([planId, week])
}

model GarminToken {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model GoogleCalendarToken {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken   String
  refreshToken  String?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model StravaToken {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken   String
  refreshToken  String
  expiresAt     DateTime  // Strava access tokens are short-lived (~6h)
  athleteId     String?   // Strava athlete id
  athleteName   String?
  scope         String?
  lastSyncedAt  DateTime? // When the background job last pulled activities
  lastSyncError String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model StravaActivity {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  stravaId       String    // Strava's own activity id (used to avoid duplicates)
  name           String
  sportType      String    // Raw Strava type, e.g. "Run", "Ride", "Swim"
  discipline     String    // Normalised: Swim | Bike | Run | Strength | Other
  startDate      DateTime
  movingTime     Int       // seconds
  elapsedTime    Int?      // seconds
  distance       Float     // meters
  elevationGain  Float?    // meters
  avgHeartRate   Float?
  maxHeartRate   Float?
  avgSpeed       Float?    // m/s
  avgWatts       Float?
  sufferScore    Float?    // Strava "relative effort" when available
  estimatedTss   Int       // Our own training-load estimate
  isTrainer      Boolean   @default(false)
  /// Whether we have pulled the detailed activity (for official best efforts).
  detailsFetched Boolean   @default(false)
  bestEfforts    StravaBestEffort[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, stravaId])
  @@index([userId, startDate])
}

/// Official "best effort" splits Strava calculates inside a run
/// (e.g. the fastest 5 km contained within a 10 km run).
model StravaBestEffort {
  id          String   @id @default(cuid())
  activityId  String
  activity    StravaActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  userId      String
  name        String   // "5k", "10k", "Half-Marathon", "Marathon", ...
  distance    Float    // metres
  elapsedTime Int      // seconds
  movingTime  Int?
  startDate   DateTime
  createdAt   DateTime @default(now())

  @@index([userId, name])
  @@unique([activityId, name])
}
